{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whetstone.invalid/schemas/findings.schema.json",
  "title": "Review findings",
  "description": "Output of the review module: one round's findings, each a cc-review Finding.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "round",
    "base",
    "head",
    "agents_run",
    "files_reviewed",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": "whetstone.findings/1"
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "base": {
      "type": "string",
      "minLength": 1
    },
    "head": {
      "type": "string",
      "minLength": 1
    },
    "agents_run": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "files_reviewed": {
      "description": "The files of the change the review looked at: every path in .review/current/pr-files.txt.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "finding.schema.json"
      }
    }
  }
}
